# Optional. Enables Gemini-powered PDF scan analysis and legal answers.
# The app sends PDF text or page images to Google Gemini when configured.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.5-flash-lite"

# Required in production to save or reset legislative parameters.
# ADMIN_ACCESS_KEY=
# Optional bind address; production defaults to 0.0.0.0, development to 127.0.0.1.
# HOST=0.0.0.0

